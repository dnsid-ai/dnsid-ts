{
  "$schema": "https://typedoc.org/schema.json",
  "name": "DNSid TypeScript SDK",
  "entryPointStrategy": "packages",
  "entryPoints": [
    "packages/sdk",
    "packages/protocol",
    "packages/transport",
    "packages/jose",
    "packages/http-signatures",
    "packages/web-bot-auth",
    "packages/oidc",
    "packages/registry",
    "packages/log-c2sp-tlog",
    "packages/key-aws",
    "packages/key-gcp"
  ],
  "out": "docs/api",
  "readme": "README.md",
  "gitRevision": "main",
  "packageOptions": {
    "sourceLinkTemplate": "https://github.com/dnsid-ai/dnsid-ts/blob/{gitRevision}/{path}#L{line}"
  },
  "includeVersion": true,
  "excludePrivate": true,
  "excludeInternal": true,
  "treatWarningsAsErrors": true,
  "validation": {
    "notDocumented": true
  }
}
