{
  "name": "@identity-digital/dnsid-oidc",
  "version": "0.19.1",
  "description": "DNSid OIDC federation profile helpers.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dnsid-ai/dnsid-ts.git",
    "directory": "packages/oidc"
  },
  "bugs": {
    "url": "https://github.com/dnsid-ai/dnsid-ts/issues"
  },
  "homepage": "https://github.com/dnsid-ai/dnsid-ts#readme",
  "keywords": [
    "dnsid",
    "oidc",
    "oauth",
    "identity"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@identity-digital/dnsid-protocol": "^0.19.1",
    "@identity-digital/dnsid-transport": "^0.19.1",
    "jose": "^6.2.10"
  },
  "license": "Apache-2.0"
}
