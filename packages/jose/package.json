  },
  "bugs": {
    "url": "https://github.com/dnsid-ai/dnsid-ts/issues"
  },
  "homepage": "https://github.com/dnsid-ai/dnsid-ts#readme",
  "keywords": [
    "dnsid",
    "jose",
    "jwt",
    "jws",
    "identity"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
