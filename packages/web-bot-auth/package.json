{
  "name": "@dnsid-ai/web-bot-auth",
  "version": "0.20.1",
  "description": "DNSid Web Bot Auth profile helpers.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dnsid-ai/dnsid-ts.git",
    "directory": "packages/web-bot-auth"
  },
  "bugs": {
    "url": "https://github.com/dnsid-ai/dnsid-ts/issues"
  },
  "homepage": "https://github.com/dnsid-ai/dnsid-ts#readme",
  "keywords": [
    "dnsid",
    "web-bot-auth",
    "http-signatures"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnsid-ai/protocol": "^0.20.1",
    "@dnsid-ai/http-signatures": "^0.20.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
