{
  "name": "@dnsid-ai/key-aws",
  "version": "0.20.0",
  "description": "DNSid AWS KMS key provider integration.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dnsid-ai/dnsid-ts.git",
    "directory": "packages/key-aws"
  },
  "bugs": {
    "url": "https://github.com/dnsid-ai/dnsid-ts/issues"
  },
  "homepage": "https://github.com/dnsid-ai/dnsid-ts#readme",
  "keywords": [
    "dnsid",
    "aws",
    "kms",
    "keys"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1124.0",
    "@dnsid-ai/protocol": "^0.20.0"
  },
  "license": "Apache-2.0"
}
