{
  "name": "@dnsid-ai/key-aws",
  "author": "Known Systems AI, Inc.",
  "version": "0.32.0",
  "description": "DNSid AWS KMS key provider integration.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE.txt"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsid-ai/dnsid-ts.git",
    "directory": "packages/key-aws"
  },
  "bugs": {
    "url": "https://github.com/dnsid-ai/dnsid-ts/issues"
  },
  "homepage": "https://github.com/dnsid-ai/dnsid-ts#readme",
  "keywords": [
    "dnsid",
    "aws",
    "kms",
    "keys"
  ],
  "scripts": {
    "prepack": "node ../../scripts/copy-notice.mjs",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.1138.0",
    "@dnsid-ai/protocol": "^0.32.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
