{
  "name": "@identity-digital/dnsid",
  "version": "0.19.1",
  "description": "Runtime-neutral DNSid SDK entrypoint with optional Node.js convenience helpers.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dnsid-ai/dnsid-ts.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/dnsid-ai/dnsid-ts/issues"
  },
  "homepage": "https://github.com/dnsid-ai/dnsid-ts#readme",
  "keywords": [
    "dnsid",
    "sdk",
    "dns",
    "identity"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/node.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@identity-digital/dnsid-protocol": "^0.19.1",
    "@identity-digital/dnsid-http-signatures": "^0.19.1",
    "@identity-digital/dnsid-jose": "^0.19.1",
    "@identity-digital/dnsid-log-c2sp-tlog": "^0.19.1",
    "@identity-digital/dnsid-registry": "^0.19.1",
    "@identity-digital/dnsid-web-bot-auth": "^0.19.1"
  },
  "peerDependencies": {
    "@identity-digital/dnsid-transport": "^0.19.1"
  },
  "peerDependenciesMeta": {
    "@identity-digital/dnsid-transport": {
      "optional": true
    }
  },
  "license": "Apache-2.0"
}
