{
  "name": "@dnsid-ai/transport",
  "author": "Known Systems AI, Inc.",
  "version": "0.31.0",
  "description": "Node.js DNS and HTTPS transport implementations for DNSid.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE.txt"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsid-ai/dnsid-ts.git",
    "directory": "packages/transport"
  },
  "bugs": {
    "url": "https://github.com/dnsid-ai/dnsid-ts/issues"
  },
  "homepage": "https://github.com/dnsid-ai/dnsid-ts#readme",
  "keywords": [
    "dnsid",
    "dns",
    "https",
    "transport",
    "node"
  ],
  "scripts": {
    "prepack": "node ../../scripts/copy-notice.mjs",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnsid-ai/protocol": "^0.31.0",
    "dns-packet": "5.6.1",
    "undici": "^8.12.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
