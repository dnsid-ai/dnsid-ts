{
  "name": "@dnsid-ai/protocol",
  "version": "0.23.0",
  "description": "DNSid protocol core contracts, TXT record parsing, JWKS validation, and identity verification engine.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsid-ai/dnsid-ts.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/dnsid-ai/dnsid-ts/issues"
  },
  "homepage": "https://github.com/dnsid-ai/dnsid-ts#readme",
  "keywords": [
    "dnsid",
    "dns",
    "identity",
    "jwks",
    "verification"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "jose": "^6.2.7"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
