{
  "name": "@dnsid-ai/registry",
  "author": "Known Systems AI, Inc.",
  "version": "0.32.0",
  "description": "DNSid registry client and TXT publishing helpers.",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "NOTICE.txt"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnsid-ai/dnsid-ts.git",
    "directory": "packages/registry"
  },
  "bugs": {
    "url": "https://github.com/dnsid-ai/dnsid-ts/issues"
  },
  "homepage": "https://github.com/dnsid-ai/dnsid-ts#readme",
  "keywords": [
    "dnsid",
    "registry",
    "identity"
  ],
  "scripts": {
    "prepack": "node ../../scripts/copy-notice.mjs",
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dnsid-ai/protocol": "^0.32.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
