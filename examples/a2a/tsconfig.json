{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "dom"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": "../..",
    "paths": {
      "@dnsid-ai/protocol": ["packages/protocol/src/index.ts"],
      "@dnsid-ai/http-signatures": ["packages/http-signatures/src/index.ts"],
      "@dnsid-ai/jose": ["packages/jose/src/index.ts"],
      "@dnsid-ai/log-c2sp-tlog": ["packages/log-c2sp-tlog/src/index.ts"],
      "@dnsid-ai/registry": ["packages/registry/src/index.ts"],
      "@dnsid-ai/transport": ["packages/transport/src/index.ts"],
      "@dnsid-ai/web-bot-auth": ["packages/web-bot-auth/src/index.ts"],
      "@dnsid-ai/sdk": ["packages/sdk/src/index.ts"],
      "@dnsid-ai/sdk/node": ["packages/sdk/src/node.ts"]
    }
  },
  "include": ["src/**/*.ts", "../shared/**/*.ts", "../../packages/**/*.ts"],
  "exclude": ["node_modules"]
}
